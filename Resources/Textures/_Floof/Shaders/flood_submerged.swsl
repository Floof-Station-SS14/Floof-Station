light_mode unshaded;

uniform sampler2D SCREEN_TEXTURE;
uniform highp float strength;

const highp float waveSize = 0.0025;

void fragment() {
    highp vec2 coord = FRAGCOORD.xy * SCREEN_PIXEL_SIZE;

    // Rows of the screen slide sideways, two waves so it never quite repeats.
    highp float wave = sin(coord.y * 28.0 + TIME * 1.3) + 0.5 * sin(coord.y * 61.0 - TIME * 2.1);
    highp vec2 displaced = coord + vec2(wave * waveSize * strength, 0.0);

    COLOR = vec4(zTextureSpec(SCREEN_TEXTURE, displaced).rgb, 1.0);
}
